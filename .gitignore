# Local reference material. Track source metadata, not binaries or full clones.
/references/papers/
/references/repos/
/references/datasets/

# External data, model weights, and caches. Keep manifests and small fixtures tracked.
/data/raw/
/data/processed/
/data/cache/
/models/
/checkpoints/
/cache/

# Generated experiment output. Keep experiment code and configs under experiments/ tracked.
/runs/
/results/
/tmps/

# Node.js dependencies, build output, and profiling artifacts.
node_modules/
dist/
coverage/
.npm/
*.tsbuildinfo
*.cpuprofile
/outputs/
/artifacts/
/wandb/
/mlruns/
/scratch/

# Secrets and machine-local configuration.
.env
.env.*
!.env.example

# WIDI 变体的凭据。settings/profiles/extensions 要跟踪（它们是实验配置的一部分），
# auth.json 是本机登录态，任何变体的都不进版本管理。
widis/*/auth.json

# Python environments, bytecode, test, type-checker, and build caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/
*.egg-info/

# Jupyter. 提交的 notebook 由 nbstripout 剥掉 cell 输出（见 .gitattributes），
# 所以 .ipynb 本身是跟踪的 —— 剥输出是为了 diff 可读，**不是**实验日志的载体。
# 日志载体是 data/processed/ 下带 _provenance 的产物加 docs/experiments/ 的记录。
# 某次运行本身值得被引用时，显式导出到 <experiment>/notebooks/runs/ 并提交；
# 该目录不在根 /runs/ 的忽略范围内（那条带前导斜杠，只匹配仓库根）。
.ipynb_checkpoints/
*-checkpoint.ipynb

# Editors and operating-system noise.
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs and temporary files.
*.log
*.tmp
*.swp
*~