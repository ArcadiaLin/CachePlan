{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E06 print-mode run plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "arm", "fixture_root", "run_root", "skill_path", "case_ids"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "arm": { "enum": ["a0", "a1", "a2"] },
    "fixture_root": { "type": "string", "minLength": 1, "description": "Absolute data/processed/e06/fixtures directory." },
    "run_root": { "type": "string", "minLength": 1, "description": "Absolute empty or new output directory for this arm/batch." },
    "skill_path": { "type": "string", "minLength": 1, "description": "Absolute canonical Skill path copied into the active workspace." },
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*-[0-9]+$" }
    },
    "resume_session_ref": {
      "type": "string",
      "minLength": 1,
      "description": "A2 only. Persisted WIDI root session reference to resume from bootstrap_leaf_id."
    },
    "bootstrap_leaf_id": {
      "type": "string",
      "minLength": 1,
      "description": "A2 only. Immutable bootstrap leaf in resume_session_ref."
    }
  },
  "allOf": [
    {
      "if": { "required": ["resume_session_ref"] },
      "then": {
        "properties": { "arm": { "const": "a2" } },
        "required": ["bootstrap_leaf_id"]
      },
      "else": { "not": { "required": ["bootstrap_leaf_id"] } }
    }
  ]
}
